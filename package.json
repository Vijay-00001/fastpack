{
  "name": "@slicedata/fastpack-v0",
  "version": "0.1.0",
  "description": "Lossless universal compression engine for JavaScript and the browser. Original pipeline: delta/RLE transforms, LZ matcher, adaptive range coder. TypeScript reference implementation of FastPack v0.",
  "type": "module",
  "main": "dist/src/api.js",
  "types": "dist/src/api.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\" \"test/*.test.mjs\"",
    "test:only": "node --test \"test/**/*.test.mjs\"",
    "bench": "npm run build && node dist/bench/bench.js",
    "build:wasm": "node scripts/embed-wasm.mjs",
    "build:node": "node scripts/build-node.mjs",
    "fp": "node fp.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
